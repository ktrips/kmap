# Xcode / Swift Package Manager
.build/
DerivedData/
*.xcodeproj/
*.xcworkspace/
.swiftpm/
xcuserdata/
*.moved-aside
*.xccheckout
*.xcscmblueprint

# xcodegenが `project.yml` の info.properties / entitlements から生成するファイル
Komap/Resources/Info.plist
Komap/Komap.entitlements
Komap Watch App/Info.plist
Komap Watch App/KomapWatchApp.entitlements

# Firebase設定（各自のFirebaseプロジェクトのものを配置し、公開リポジトリにはコミットしない）
Komap/Resources/GoogleService-Info.plist
Komap/Resources/GoogleService-Info_old.plist
web/.env
web/.env.local

# Firebase CLIのローカルキャッシュ
.firebase/

# APIキーなどの秘密情報(各自ローカルで設定し、コミットしない)
Config/Secrets.xcconfig

# macOS
.DS_Store

# Salesforce DX tooling metadata (auto-generated locally)
.sfdx/

# Kindle本の原稿（全文）。公開リポジトリには置かない。Web版の全文は
# scripts/upload-kindle-full-text.sh で Firebase Storage（premium/kindle-full.md）に上げ、
# Komap Plus の人にだけ Cloud Function が返す。無料で読める冒頭部分は web/public/kindle-preview.md。
/private/
