rules_version = '2';

// 各ユーザーは自分の `users/{uid}/places/**` 配下のみ読み書きできる。
// iOSアプリ・Webアプリ（map.ktrips.net）は、どちらもこの同じルールの下で
// Firebase Authenticationでサインインしたuidを使ってアクセスする。
service cloud.firestore {
  match /databases/{database}/documents {
    // 管理者（Cloud Functions の`functions/src/adminEmail.ts`と同じアドレス）。
    // `request.auth.token.email`はFirebase Authが検証した値のため、他人が名乗ることはできない。
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.email == 'kenichiyoshida13@gmail.com';
    }

    match /users/{userId}/places/{placeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/stamps/{stampId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 旅の正本。公開・非公開は`isSharedPublicly`だけで切り替える。本人は常に読み書きでき、
    // 公開中の旅は誰でも（サインインしていない訪問者も）読める。公開ページ用の項目（写真の一覧・件数など）は
    // Cloud Functions（functions/src/sharedTrips.ts）が書き込む。
    match /users/{userId}/walkRoutes/{walkRouteId} {
      // Cloud Functions だけが書く項目。本人も含め、クライアントからは書き換えられない（件数の水増しなどを防ぐ）。
      function functionManagedKeys() {
        return ['tripId', 'ownerDisplayName', 'stampPhotos', 'postPhotos', 'likeCount', 'commentCount',
                'startLatitude', 'startLongitude'];
      }
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read: if isOwner() || resource.data.isSharedPublicly == true;
      allow create: if isOwner() && !request.resource.data.keys().hasAny(functionManagedKeys());
      allow update: if isOwner()
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(functionManagedKeys());
      allow delete: if isOwner();
    }

    // 「みんなの時空旅」の一覧（全ユーザーの旅から公開中のものを探すコレクショングループクエリ）。
    // クエリには`isSharedPublicly == true`の条件が必要（ルールは絞り込みではないため）。
    match /{path=**}/walkRoutes/{walkRouteId} {
      allow read: if resource.data.isSharedPublicly == true;
    }

    match /users/{userId}/photoPosts/{photoPostId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 公開した旅への「いいね」「コメント」の置き場所（`sharedTrips/{tripId}/likes|comments`）。
    // 旅そのものは`users/{uid}/walkRoutes`にあり、以前の公開用のコピー（この文書の中身）は移行後は使わない。
    // 古いコピーは、持ち主だけが消せる。
    match /sharedTrips/{tripId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.ownerUserID == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUserID == request.auth.uid;

      // 「いいね」: 文書のIDを自分のuidに固定することで、1人1いいねを強制する。
      // 中身は持たず、存在すること自体が「いいねした」を表す。
      match /likes/{uid} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }

      // コメント: サインイン済みユーザーなら誰でも投稿できるが、投稿者本人のuidを
      // 偽れないようにし、文字数も制限する。編集は不可（削除して投稿し直す想定）。
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
                        && request.resource.data.authorUserID == request.auth.uid
                        && request.resource.data.text is string
                        && request.resource.data.text.size() > 0
                        && request.resource.data.text.size() <= 500;
        allow delete: if request.auth != null && resource.data.authorUserID == request.auth.uid;
      }
    }

    // 「みんなの古地図」: 追加した古地図の公開データ。読み取りは誰でも可。
    // 作成・更新・削除は、ownerUserIDが自分のuidの文書だけ。
    match /sharedOverlayMaps/{mapId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.ownerUserID == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUserID == request.auth.uid;
    }

    // 「みんなの時空旅」ランキング用の公開統計。表示名・今週/通算ポイントのみを持ち、
    // 本人だけが自分のドキュメントを書ける。全員のランキングを見せるため読み取りは誰でも可。
    match /userPublicStats/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 友達申請。送信は本人（fromUID）のみ。受信側は`toUID`が自分の場合に加え、
    // メールアドレス指定招待（`toUID`が未確定）で`toEmail`が自分の検証済みメールと
    // 一致する場合も読める（サインイン時に自分宛の招待を拾って`toUID`を確定させるため）。
    // `request.auth.token.email`はFirebase AuthのIDトークンに含まれる検証済みの値のため、
    // クライアントが他人のメールアドレスを騙って横取りすることはできない。
    match /friendRequests/{requestId} {
      allow read: if request.auth != null
                    && (resource.data.fromUID == request.auth.uid
                        || resource.data.toUID == request.auth.uid
                        || (resource.data.toUID == null && resource.data.toEmail == request.auth.token.email));
      allow create: if request.auth != null
                      && request.resource.data.fromUID == request.auth.uid
                      && request.resource.data.status == 'pending';
      allow update: if request.auth != null && resource.data.status == 'pending' && (
                      // 受信者（toUIDが確定済み）が承認・却下する
                      (resource.data.toUID == request.auth.uid
                        && request.resource.data.status in ['accepted', 'declined']
                        && request.resource.data.fromUID == resource.data.fromUID
                        && request.resource.data.toUID == resource.data.toUID)
                      ||
                      // メール招待の宛先本人が、サインイン後に自分宛と確定させる（toUIDを埋める）
                      (resource.data.toUID == null
                        && resource.data.toEmail == request.auth.token.email
                        && request.resource.data.toUID == request.auth.uid
                        && request.resource.data.status == 'pending')
                      ||
                      // 送信者本人がキャンセルする
                      (resource.data.fromUID == request.auth.uid
                        && request.resource.data.status == 'cancelled'
                        && request.resource.data.fromUID == resource.data.fromUID
                        && request.resource.data.toUID == resource.data.toUID)
                    );
    }

    // 友達関係。1組につき1文書（IDは両者のuidをソートして連結したキー）。
    // 承認済みの友達申請（fromUID/toUIDが一致する`friendRequests`文書）を参照できる時だけ、
    // その2人のいずれかが作成できる。
    match /friendships/{pairKey} {
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null
                      && request.auth.uid in request.resource.data.uids
                      && request.resource.data.uids.size() == 2
                      && request.resource.data.requestId is string
                      && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
                      && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.fromUID in request.resource.data.uids
                      && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUID in request.resource.data.uids;
      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
    }

    // Web版の「今◯人が時空旅中」表示用の、生存確認（ハートビート）専用コレクション。
    // サインインしていない訪問者も含め誰でも自分のセッションIDの文書を書き込める必要があるため
    // 認証チェックは行わないが、書き込める内容は`lastSeen`（タイムスタンプ）1つだけに限定する。
    match /presence/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['lastSeen'])
                             && request.resource.data.lastSeen is timestamp;
      allow delete: if true;
    }

    // Komap Plus を購入せずに使える人（プロモユーザー）。文書IDは小文字のメールアドレス。
    // 登録・削除・一覧は管理者だけ。本人は、自分が登録されているかだけを読める（iOSアプリが確かめる）。
    match /plusPromoUsers/{email} {
      allow read: if isAdmin()
                    || (request.auth != null
                        && request.auth.token.email_verified == true
                        && request.auth.token.email.lower() == email);
      allow create, update: if isAdmin()
                              && request.resource.data.keys().hasOnly(['email', 'note', 'grantedAt', 'grantedBy'])
                              && request.resource.data.email == email
                              && email == email.lower()
                              && request.resource.data.note is string
                              && request.resource.data.note.size() <= 200;
      allow delete: if isAdmin();
    }

    // 上記以外はすべて拒否（デフォルト拒否）
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
