rules_version = '2';

// 各ユーザーは自分の `users/{uid}/places/**` 配下のみ読み書きできる。
// iOSアプリ・Webアプリ（map.ktrips.net）は、どちらもこの同じルールの下で
// Firebase Authenticationでサインインしたuidを使ってアクセスする。
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/places/{placeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/stamps/{stampId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/walkRoutes/{walkRouteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/photoPosts/{photoPostId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 「みんなの時空旅」: サインインしていれば誰でも読めるが、
    // 書き込み・削除は自分（ownerUserID）のドキュメントのみ。
    match /sharedTrips/{tripId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.ownerUserID == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUserID == request.auth.uid;
    }

    // 上記以外はすべて拒否（デフォルト拒否）
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
