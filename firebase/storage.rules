rules_version = '2';

// 各ユーザーは自分の users/{uid}/** 配下の画像のみ読み書きできる。
// 「みんなの時空旅」として公開したものは、Cloud Functions等は使わず、
// アップロード時にオーナー自身が sharedPhotos/{tripId}/** にも同じ画像を書き込む方式にする
// （どちらも書き込みはオーナー本人のみ、読み取りはサインイン済みなら誰でも可）。
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /sharedPhotos/{tripId}/{allPaths=**} {
      allow read: if request.auth != null;
      // 対応する sharedTrips/{tripId} ドキュメントの持ち主だけが書き込める。
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/sharedTrips/$(tripId)).data.ownerUserID == request.auth.uid;
    }
  }
}
